{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SarembokConfiguration",
  "type": "object",
  "properties": {
    "engine": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["strict", "aggressive", "simulation"]
        },
        "max_latency_ms": {
          "type": "integer",
          "default": 1000
        }
      },
      "required": ["mode"]
    },
    "entropy_defense": {
      "type": "object",
      "properties": {
        "shannon_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.88
        },
        "sliding_window_size": {
          "type": "integer",
          "minimum": 3,
          "default": 10
        },
        "action_on_halt": {
          "type": "string",
          "enum": ["rollback", "pause", "delegate_to_human"]
        }
      },
      "required": ["shannon_threshold", "sliding_window_size", "action_on_halt"]
    },
    "memory": {
      "type": "object",
      "properties": {
        "db_path": {
          "type": "string",
          "default": "sarembok_memory.db"
        },
        "wal_mode": {
          "type": "boolean",
          "default": true
        },
        "synchronous": {
          "type": "string",
          "enum": ["OFF", "NORMAL", "FULL"],
          "default": "NORMAL"
        }
      },
      "required": ["db_path", "wal_mode"]
    },
    "openshell": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "profile": {
          "type": "string",
          "enum": ["strict", "enterprise", "audit", "developer"],
          "default": "strict"
        },
        "policy_path": {
          "type": "string",
          "default": "./Config/openshell.policy.yaml"
        },
        "secret_zero": {
          "type": "boolean",
          "default": true
        },
        "hitl_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "required": ["engine", "entropy_defense", "memory"]
}
