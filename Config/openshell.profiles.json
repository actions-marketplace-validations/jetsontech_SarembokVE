{
  "active_profile": "strict",
  "profiles": {
    "strict": {
      "description": "Zero-trust banking and production grade isolation. All egress whitelisted, strict deny-by-default, Secret Zero required, all mutations require HITL approval.",
      "filesystem": {
        "read_only_root": true,
        "allowed_paths": ["/workspace", "./generated", "./public", "./scratch", "/tmp"],
        "deny_paths": ["~/.ssh", "~/.aws", ".env", "**/.env*", "**/id_rsa*", "C:/Windows/System32", "/etc/shadow", "/etc/sudoers", "**/credentials.json"]
      },
      "network": {
        "egress_mode": "whitelist",
        "allowed_domains": ["github.com", "api.github.com", "registry.npmjs.org", "sarembok.com", "*.sarembok.com", "*.google.com", "localhost", "127.0.0.1"],
        "denied_ports": [22, 25, 3389, 445, 135]
      },
      "commands": {
        "max_memory_mb": 768,
        "max_execution_time_ms": 5000,
        "drop_capabilities": ["ALL"],
        "deny_patterns": [
          "rm\\s+-rf\\s+[/~]",
          "format\\s+[a-z]:",
          "mkfs",
          "dd\\s+if=",
          "chmod\\s+777",
          "DROP\\s+(TABLE|DATABASE|VIEW|SCHEMA)",
          "TRUNCATE\\s+(TABLE)?",
          "DELETE\\s+FROM\\s+\\w+\\s*(?!WHERE)",
          "shutdown",
          "reboot",
          "kill\\s+-9\\s+1",
          "curl.*\\|.*(sh|bash|powershell)",
          "wget.*\\|.*(sh|bash|powershell)"
        ]
      },
      "hitl_triggers": {
        "require_approval": [
          "production_db_write",
          "production_db_migration",
          "external_payment",
          "financial_transaction",
          "privileged_execution",
          "cloud_resource_destroy",
          "external_email_dispatch"
        ],
        "auto_timeout_seconds": 300,
        "action_on_timeout": "reject"
      },
      "secret_zero": {
        "enabled": true,
        "mask_in_logs": true,
        "redact_in_responses": true
      }
    },
    "enterprise": {
      "description": "Standard corporate enterprise container boundary with managed intranet access and audit trails.",
      "filesystem": {
        "read_only_root": true,
        "allowed_paths": ["/workspace", "./generated", "./public", "./scratch", "/tmp", "./data"],
        "deny_paths": ["~/.ssh", "~/.aws", ".env", "**/.env*", "**/id_rsa*"]
      },
      "network": {
        "egress_mode": "whitelist",
        "allowed_domains": ["*.internal.corp", "github.com", "api.github.com", "sarembok.com", "*.sarembok.com", "*.googleapis.com", "localhost"],
        "denied_ports": [22, 25, 3389]
      },
      "commands": {
        "max_memory_mb": 1536,
        "max_execution_time_ms": 15000,
        "drop_capabilities": ["ALL"],
        "deny_patterns": [
          "rm\\s+-rf\\s+[/~]",
          "format\\s+[a-z]:",
          "mkfs",
          "DROP\\s+DATABASE",
          "shutdown",
          "reboot"
        ]
      },
      "hitl_triggers": {
        "require_approval": ["production_db_write", "financial_transaction", "cloud_resource_destroy"],
        "auto_timeout_seconds": 600,
        "action_on_timeout": "reject"
      },
      "secret_zero": {
        "enabled": true,
        "mask_in_logs": true,
        "redact_in_responses": true
      }
    },
    "audit": {
      "description": "Read-only auditor sandbox for Playwright dynamic DOM crawling and contract reverse-engineering.",
      "filesystem": {
        "read_only_root": true,
        "allowed_paths": ["/tmp", "./generated", "./public"],
        "deny_paths": ["~/.ssh", "~/.aws", ".env", "**"]
      },
      "network": {
        "egress_mode": "unrestricted_http_only",
        "allowed_domains": ["*"],
        "denied_ports": [22, 25, 3389, 445]
      },
      "commands": {
        "max_memory_mb": 768,
        "max_execution_time_ms": 10000,
        "drop_capabilities": ["ALL"],
        "deny_patterns": [".*"]
      },
      "hitl_triggers": {
        "require_approval": [],
        "auto_timeout_seconds": 60,
        "action_on_timeout": "reject"
      },
      "secret_zero": {
        "enabled": true,
        "mask_in_logs": true,
        "redact_in_responses": true
      }
    },
    "developer": {
      "description": "Relaxed developer mode for local testing on workstation.",
      "filesystem": {
        "read_only_root": false,
        "allowed_paths": ["*"],
        "deny_paths": ["~/.ssh", ".env"]
      },
      "network": {
        "egress_mode": "allow_all",
        "allowed_domains": ["*"],
        "denied_ports": []
      },
      "commands": {
        "max_memory_mb": 4096,
        "max_execution_time_ms": 60000,
        "drop_capabilities": [],
        "deny_patterns": ["rm\\s+-rf\\s+/", "format\\s+c:"]
      },
      "hitl_triggers": {
        "require_approval": ["financial_transaction"],
        "auto_timeout_seconds": 3600,
        "action_on_timeout": "reject"
      },
      "secret_zero": {
        "enabled": false,
        "mask_in_logs": false,
        "redact_in_responses": false
      }
    }
  }
}
